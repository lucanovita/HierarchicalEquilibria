function spohn_row_ij(i,j, R, p, X) #i is a player, j is choice for player i
    g = zero(R)
    g1 = zero(R)
    for k in 1:2
        for l in 1:2
            if i == 1
                g = g + p[j,k,l]
                g1 = g1 + X[j,k,l]*p[j,k,l]
            elseif i == 2
                g = g + p[k,j,l]
                g1 = g1 + X[k,j,l]*p[k,j,l]
            elseif i == 3
                g = g + p[k,l,j]
                g1 = g1 + X[k,l,j]*p[k,l,j]
            end 
        end 
    end
    return [g,g1]
end 

function spohnMatrix_i(i, R, p, Game)
    r1 = spohn_row_ij(i,1,R,p,Game[i])
    r2 =  spohn_row_ij(i,2,R,p,Game[i])
    return matrix(R, [r1,r2])
end 


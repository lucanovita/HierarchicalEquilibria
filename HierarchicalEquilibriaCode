function payoff_proj(v, Game)
    p1 = 0
    p2 = 0
    p3 = 0 
    counter = 0
    for i in 1:2
        for j in 1:2
            for k in 1:2
                counter = counter + 1
                p1 = p1 + Game[1][i,j,k]*v[counter]
                p2 = p2 + Game[2][i,j,k]*v[counter]
                p3 = p3 + Game[3][i,j,k]*v[counter]
                
            end
        end
    end
    return [p1,p2,p3]
end



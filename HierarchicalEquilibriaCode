function hier_param(facets, players)
    R, gen = RingParameters(facets, players)
    D = Dict(string(v) => v for v in gens(R))
    comb = get_combinationss(players)
    equations = []
    for c in comb 
        eq = D["q$(c)"] - prod([D[z] for z in select_parameter(c,facets)])
        equations = push!(equations,eq)
    end

    return [R,equations]
     
end



function hier_ideal(facets,players)
    o = hier_param(facets,players)
    R = o[1]
    equations = o[2]
    I = ideal(R,equations)
    get_rid = [gens(R)[i] for i in (prod(players) + 1):length(gens(R))]
    I = Oscar.eliminate(I, get_rid)
    gens_I = gens(I)
    return gens_I
end


#this function will take a symbolic polynomial and return a corresponding function
function polyToPoly(sym_p)
    string_poly = string(sym_p)
    mapping = [
        "p[1, 1, 1]" => "v[1]",
        "p[1, 1, 2]" => "v[2]",
        "p[1, 2, 1]" => "v[3]",
        "p[1, 2, 2]" => "v[4]",
        "p[2, 1, 1]" => "v[5]",
        "p[2, 1, 2]" => "v[6]",
        "p[2, 2, 1]" => "v[7]",
        "p[2, 2, 2]" => "v[8]",
    ]
    for (old, new) in mapping
        string_poly = replace(string_poly, old => new)
    end 
    parsed_expr = Meta.parse(string_poly)
    poly = eval(:(v -> $parsed_expr))
end 


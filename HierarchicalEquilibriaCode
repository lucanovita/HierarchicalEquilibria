function softmax(y)
    ey = exp.(y .- maximum(y))
    return ey ./ sum(ey)
end

function err_fun(z)
    function a(y) 
        v = softmax(y)
        return sum(poly(v)^2 for poly in z) #constrains the optimizer to the prob simpl
    end 
    return a
end

function ApproxSolutions(n_samples, poly_system, tolerance)
    count = 0
    approx_sol = []
    err = err_fun(poly_system)
    while count < n_samples
        n = 1000
        vv = randn(8) 
        #sum_vv = sum(vv[i] for i in 1:7)
        #vv = push!(vv, (1 - sum_vv))
        res = optimize(err, vv)
        if Optim.minimum(res) < tolerance
            push!(approx_sol, softmax(Optim.minimizer(res)))
            count = count + 1
        end
    end
    return approx_sol
end

function SpohnNotHier(spohn_points, hier_system, tolerance)
    not_hierarchical = []
    hierarchical = []
    for p in spohn_points 
        if sum(poly(p)^2 for poly in hier_system) > tolerance
            not_hierarchical = push!(not_hierarchical,p)
        else 
            hierarchical = push!(hierarchical,p)
        end
    end
    return [not_hierarchical, hierarchical]
end


















function GeneratorsVarieties(X, facets)
    probabilityRing, p= graded_polynomial_ring(QQ, "p" => (1:2, 1:2, 1:2)) 
    gensSpohn = [det(spohnMatrix_i(i, probabilityRing, p, X)) for i in 1:3]
    SI = ideal(probabilityRing, gensSpohn)
    SpohnDimension = Oscar.dim(SI)
    gens_spohn = minimal_generating_set(SI)
    hier_generators_q = hier_ideal(facets,[2,2,2]) #generator of hierarchical ideal in the q vars 
    new_vars = vec(p) 
    num_oldvars = length(gens(parent(hier_generators_q[1])))
    for i in 1:(num_oldvars-prod([2,2,2]))
        new_vars = push!(new_vars, zero(probabilityRing))
    end
    H = hom(parent(hier_generators_q[1]),probabilityRing,new_vars)
    HierModel = ideal(probabilityRing, [H(hier_generators_q[z]) for z in 1:length(hier_generators_q)])
    IntersectionIdeal = HierModel + SI
    SpohnHierarchical = IntersectionIdeal

    for i in 1:2
        for j in 1:2
            for k in 1:2
                SpohnHierarchical = saturation(SpohnHierarchical, ideal(probabilityRing, p[i,j,k]))
            end
        end
    end
    SpohnHierarchical = saturation(SpohnHierarchical, ideal(probabilityRing,sum(p[i,j,k] for i in 1:2 for j in 1:2 for k in 1:2)))
    SpohnHierarchicalDimension = Oscar.dim(SpohnHierarchical)
    gens_hierarch = minimal_generating_set(SpohnHierarchical)
    spohn_poly_system = [polyToPoly(gen) for gen in gens_spohn]
    hierarch_poly_system = [polyToPoly(gen) for gen in gens_hierarch]
    return [spohn_poly_system, hierarch_poly_system,SpohnDimension,SpohnHierarchicalDimension,Oscar.dim(HierModel)]

end







function PayoffRegion(generators, tolerance, num_samples)#optionRed, optionGreen)

    approx_points = ApproxSolutions(num_samples, generators[1], tolerance)
    approx_points_divided = SpohnNotHier(approx_points, generators[2], tolerance)
    PayoffOfNotHierarchicalSpohn = [Point3f(payoff_proj(approx_points_divided[1][i], X)) for i in 1:length(approx_points_divided[1])]

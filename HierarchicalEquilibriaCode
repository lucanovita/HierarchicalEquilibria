function RingParameters(facets, players)
    paramFF = []
    for F in facets 
        paramF = ()
        for i in F
            paramF = (paramF...,1:players[i])
        end 
        paramFF = push!(paramFF, paramF)
    end
    
    indexes = ()
    for i in 1:length(players)
        indexes = (indexes...,1:players[i])
    end
    parameter_ring, gens= polynomial_ring(QQ, "q" => indexes, ["t_F$(i)" => paramFF[i] for i in 1:length(facets)]...) # the three dots unpack the vector so that the function sees it as positional separeted arguments
    return [parameter_ring,gens]
end 



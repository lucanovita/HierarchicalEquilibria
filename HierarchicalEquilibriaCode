        points_color = fill(RGB(1.0,0.0,0.0), length(PayoffOfNotHierarchicalSpohn))
        spohnVarietyPoints = PointCloud(PayoffOfNotHierarchicalSpohn,points_color)
        setobject!(vis["spohnPoints"],   spohnVarietyPoints, mat_Spohn_points)

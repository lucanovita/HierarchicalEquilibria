function select_parameter(combination, facets)
   appearing_vars = []
   for i in 1:length(facets)
        aux = []
        for j in facets[i]
            aux = push!(aux,j)
        end
        selectedValues = [combination[k] for k in aux]
        appearing_vars = push!(appearing_vars, "t_F$(i)$(selectedValues)")
        
   end
   return appearing_vars
end


        setobject!(vis["hierPoints"],   HierVarietyPoints, mat_hier_points)
    end

    open(vis)
    return [vis, aiutoDesmos]
end


function KonstanzMatrix(game, ring)
    n = length(game)
    rows = []
    v = gens(ring) #the variables will be x1...xn where xi is expected payoff for player i
    for j in (1:n)
        for choice_j in 1:2
            current_row = []
            for i in 1:2
                for z in 1:2
                    for k in 1:2
                        if j == 1 && (choice_j == 1)
                            if i == 1
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                        if j == 1 && (choice_j == 2)
                            if i == 2
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                        if j == 2 && (choice_j == 1)
                            if z == 1
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                        if j == 2 && (choice_j == 2)
                            if z == 2
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                        if j == 3 && (choice_j == 1)
                            if k == 1
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                        if j == 3 && (choice_j == 2)
                            if k == 2
                                current_row = push!(current_row, v[j] - game[j][i,z,k])
                            else
                                current_row = push!(current_row, 0)
                            end 
                        end
                    end
                end
            end
            rows = push!(rows, current_row)
        end
        
    end 
    return rows
end
